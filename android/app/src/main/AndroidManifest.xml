<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.vulkan.version" android:required="false" android:version="0x00401000" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- On-device GPU captures (debuggable builds): Android loads the RenderDoc Vulkan layer from this package only
         if the app can see it (package visibility, API 30+). -->
    <queries>
        <package android:name="org.renderdoc.renderdoccmd.arm64" />
    </queries>
    <application android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false" android:resizeableActivity="false"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
        android:appCategory="game" android:isGame="true">
        <!-- Lets simpleperf sample the release build for performance work (no debugging, no data access). -->
        <profileable android:shell="true" />
        <activity android:name=".LauncherActivity" android:exported="true" android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|screenLayout|smallestScreenSize|orientation|uiMode|density">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity android:name=".VulkanTestActivity" android:exported="false" android:process=":vktest" android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|navigation|density" />
        <activity android:name=".GameActivity" android:exported="false" android:process=":game" android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|navigation|density" />
        <activity android:name=".GpuProbeActivity" android:exported="false" android:process=":probe" android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
